# ─────────────────────────────────────────────
# Reddit bot credentials (script-type app)
# Create at: reddit.com/prefs/apps → script
# ─────────────────────────────────────────────
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_USER_AGENT=LoanCentralBot/1.0 by your_username

# ─────────────────────────────────────────────
# Subreddit(s) the bot monitors
# Comma-separated for multiple: sub1,sub2
# ─────────────────────────────────────────────
SUBREDDITS=

# Flair text required to use $loan (default: Verified Lender)
LENDER_FLAIR=Verified Lender

# ─────────────────────────────────────────────
# Database
# Use DATABASE_URL for cloud (Render/Supabase)
# OR use individual DB_* vars for local Postgres
# ─────────────────────────────────────────────
DATABASE_URL=

DB_HOST=localhost
DB_PORT=5432
DB_NAME=loancentral
DB_USER=
DB_PASSWORD=

# ─────────────────────────────────────────────
# Dashboard (Flask web app)
# ─────────────────────────────────────────────
DASHBOARD_URL=http://localhost:5000
SECRET_KEY=change-me-to-a-long-random-string
API_KEY=change-me-to-a-long-random-string

# Reddit OAuth for dashboard login (web-type app)
# Create at: reddit.com/prefs/apps → web app
# Redirect URI must match exactly
DASHBOARD_CLIENT_ID=
DASHBOARD_CLIENT_SECRET=
DASHBOARD_REDIRECT_URI=http://localhost:5000/auth/callback

# ─────────────────────────────────────────────
# Notifications (all optional)
# ─────────────────────────────────────────────

# Discord webhook (for bot event alerts)
DISCORD_WEBHOOK_URL=

# Twilio SMS reminders
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# SMTP email notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ADMIN_EMAIL=

# ─────────────────────────────────────────────
# Optional tuning
# ─────────────────────────────────────────────
REMINDER_INTERVAL_SECONDS=3600
LOANCENTRAL_ENV=prod
