# Reddit API credentials
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
# Reddit requires a unique, self-identifying user agent in the shape
#   <platform>:<app ID>:<version> (by /u/<reddit username>)
# The bot refuses to start live if this is left as a placeholder.
REDDIT_USER_AGENT=python:loancentral-bot:1.0 (by /u/YOUR_BOT_ACCOUNT)
# Set to dry_run to swap the live Reddit client for a local logging stub.
REDDIT_MODE=live

# Subreddit config
# Use commas for multiple subreddits, for example: LoanCentral,LoanCentralEU
SUBREDDITS=

# PostgreSQL database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=loancentral
DB_USER=
DB_PASSWORD=

# Safety switches
REMINDER_REDDIT_ENABLED=false
AUTO_BAN_REDDIT_ENABLED=false
REDDIT_FLAIR_SYNC_ENABLED=false

# Optional extra gate: also require the 'Verified Lender' Reddit flair for
# lender commands. Off by default - the DB is the source of truth for
# permissions (docs/SECURITY.md rule 2), and reading flair needs the bot to
# be a moderator, so a lost mod role would deny every lender at once.
REQUIRE_LENDER_FLAIR=false

# Days before an open loan request is auto-expired.
REQUEST_EXPIRE_DAYS=10
