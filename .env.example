# Reddit API credentials
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_USER_AGENT=LoanCentralBot/1.0 by your_username

# Subreddit config
# Use commas for multiple subreddits, for example: LoanCentral,LoanCentralEU
SUBREDDITS=

# Dashboard web app URL (shown in bot replies to funnel users to the site)
DASHBOARD_URL=http://localhost:5000

# Dashboard Reddit OAuth (web app, not script app)
DASHBOARD_CLIENT_ID=
DASHBOARD_CLIENT_SECRET=
DASHBOARD_REDIRECT_URI=http://localhost:5000/auth/callback

# PostgreSQL database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=loancentral
DB_USER=
DB_PASSWORD=

